<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Talking to the owner's own computer. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Reading the photo library. Android 13 split the old blanket storage
         permission into per-type ones, so all of them are declared:
         READ_MEDIA_IMAGES and READ_MEDIA_VIDEO for 13 and later, and
         READ_EXTERNAL_STORAGE capped at 12 for older phones. Declaring only one
         leaves the other half of the market unable to back anything up, which
         is the whole feature.

         READ_MEDIA_VIDEO was missing until September 2026, and the failure was
         silent in the worst way. The scan asks PhotoManager for
         RequestType.common — photos AND videos — but a permission that is not
         declared can never be granted, so on Android 13+ videos were simply
         never enumerated. Never enumerated means never counted, never failed,
         and never listed among the reasons something did not go. The backup
         screen said "Backed up. 0 new" over a camera roll full of unbacked-up
         video. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Notably NOT requested: WRITE_EXTERNAL_STORAGE, location, contacts or
         anything else. The app reads photos and sends them to one address. -->

    <!-- Backing up without the app open (see lib/background.dart).

         WorkManager needs all four, and each one is load-bearing:
           RECEIVE_BOOT_COMPLETED  re-registers the schedule after a restart.
                                   Without it automatic backup works until the
                                   first reboot and then silently never again,
                                   which is the worst possible failure for a
                                   backup: it looks fine.
           FOREGROUND_SERVICE      a long upload has to be a foreground service
                                   or Android kills it partway.
           ..._DATA_SYNC           Android 14 requires a TYPE as well, and
                                   refuses to start the service without one.
                                   dataSync is what "upload the user's files"
                                   is; mediaPlayback would be a lie.
           POST_NOTIFICATIONS      Android 13+ will not show the foreground
                                   service's own notification otherwise, and a
                                   foreground service with no visible
                                   notification is exactly what the OS stops.

         ACCESS_NETWORK_STATE is what lets WorkManager honour "wifi only"
         itself, so the constraint is enforced by the system rather than by us
         checking after the upload has already started. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Installing a downloaded update APK from inside the app. Android 8+ gates
         this per-source: the user is sent to Settings once to allow "install
         unknown apps" for SafeNest, then the package installer takes over. The
         app is distributed as a direct download (no store), so this is how it
         updates itself. Without it the install intent is silently refused. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- networkSecurityConfig permits plain http to a home address only, never to
         the internet. A computer at 192.168.1.5 has no certificate and cannot get
         one; the app itself refuses http for any public address, in
         Session.normaliseAddress. -->
    <application
        android:label="SafeNest"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
