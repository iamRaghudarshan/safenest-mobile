<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Talking to the owner's own computer. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Reading the photo library. Android 13 split the old blanket storage
         permission into per-type ones, so all of them are declared:
         READ_MEDIA_IMAGES and READ_MEDIA_VIDEO for 13 and later, and
         READ_EXTERNAL_STORAGE capped at 12 for older phones. Declaring only one
         leaves the other half of the market unable to back anything up, which
         is the whole feature.

         READ_MEDIA_VIDEO was missing until September 2026, and the failure was
         silent in the worst way. The scan asks PhotoManager for
         RequestType.common — photos AND videos — but a permission that is not
         declared can never be granted, so on Android 13+ videos were simply
         never enumerated. Never enumerated means never counted, never failed,
         and never listed among the reasons something did not go. The backup
         screen said "Backed up. 0 new" over a camera roll full of unbacked-up
         video. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Notably NOT requested: WRITE_EXTERNAL_STORAGE, location, contacts or
         anything else. The app reads photos and sends them to one address. -->

    <!-- Backing up without the app open (see lib/background.dart).

         Two, and only two:
           RECEIVE_BOOT_COMPLETED  re-registers the schedule after a restart.
                                   Without it automatic backup works until the
                                   first reboot and then silently never again,
                                   which is the worst possible failure for a
                                   backup: it looks fine.
           ACCESS_NETWORK_STATE    lets WorkManager enforce "Wi-Fi only"
                                   itself, so the constraint is applied by the
                                   system rather than by us checking after an
                                   upload has already started.

         Deliberately NOT declared: FOREGROUND_SERVICE and
         FOREGROUND_SERVICE_DATA_SYNC. An earlier version of this file asked
         for both. This app schedules ordinary periodic work and never passes
         a foregroundServiceConfig, so it never starts a foreground service —
         asking for the permission would have been claiming a capability the
         code does not use. FOREGROUND_SERVICE_DATA_SYNC is also a Play
         Console special type needing a declaration form and a demonstration
         video, which the workmanager plugin avoids declaring for exactly that
         reason.

         POST_NOTIFICATIONS is not here either: the plugin's own manifest
         declares it, and manifest merging brings it in. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- TRACK ME. The comment above says location is deliberately not asked
         for, and that was true until this module: SafeNest read photos and
         sent them to one address, and nothing else.

         It is still not asked for at launch, and nothing is recorded until
         somebody turns the module on. Declaring a permission is not using it —
         what matters is that the request happens the first time the switch is
         touched, and that the switch is off in a fresh install.

         FINE and COARSE together: Android requires COARSE alongside FINE from
         API 31, and a phone that grants only the approximate one still gives a
         usable timeline — a few hundred metres is plenty to tell home from the
         office, and it is better than refusing to record at all.

         BACKGROUND is the one that decides whether the module works. Without
         it the timeline fills in while you are looking at the phone and records
         nothing the moment it goes in a pocket — which is every part of the day
         worth recording. It is asked for separately and after the first, as
         Android 11+ insists.

         FOREGROUND_SERVICE_LOCATION is API 34's requirement for a service that
         reads position, and it goes with the notification that says recording
         is happening. The notification is not a formality here: a location
         recorder with no visible sign of running is the thing nobody should
         ship. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Installing a downloaded update APK from inside the app. Android 8+ gates
         this per-source: the user is sent to Settings once to allow "install
         unknown apps" for SafeNest, then the package installer takes over. The
         app is distributed as a direct download (no store), so this is how it
         updates itself. Without it the install intent is silently refused. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- networkSecurityConfig permits plain http to a home address only, never to
         the internet. A computer at 192.168.1.5 has no certificate and cannot get
         one; the app itself refuses http for any public address, in
         Session.normaliseAddress. -->
    <application
        android:label="SafeNest"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- THE TWO RECEIVERS A SCHEDULED NOTIFICATION NEEDS.
             flutter_local_notifications does NOT declare these in its own
             manifest — it asks the host app to, and nothing here had. Confirmed
             by unzipping the built APK and reading the merged manifest: neither
             name appeared in it.

             ScheduledNotificationReceiver is what AlarmManager hands the alarm
             to when it fires. Without it the alarm is set against a component
             that does not exist and nothing is ever shown.

             ScheduledNotificationBootReceiver puts the whole queue back after a
             restart, and Android drops every scheduled alarm on reboot. That
             matters most for the things furthest out: a warranty warning set two
             years ahead would be gone the first time the phone was restarted,
             and would simply never arrive, with nothing to point at. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- An app UPDATE clears the queue too, not just a reboot. Every
                     release would otherwise silently drop every pending
                     reminder on every phone. -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
