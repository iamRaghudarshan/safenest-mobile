<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>

	<!-- WHY THE APP NEEDS THE PHOTO LIBRARY, in the owner's words.

	     iOS shows this sentence verbatim in the permission box, and it is the
	     only explanation most people will ever read. "SafeNest needs access to
	     your photos" says nothing; saying where the photos go — and that they go
	     nowhere else — is the whole product.

	     Without this key the app does not merely lack permission: it is killed
	     the instant it asks. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>So SafeNest can back up your photos to your own computer. They are copied straight to the machine you signed in to, and nowhere else.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>So SafeNest can save a photo back to this phone when you ask it to.</string>

	<!-- REQUIRED EVEN THOUGH THIS APP DOES NOT OPEN THE CAMERA ITSELF.
	     Apple rejected build 4 with ITMS-90683 for the want of this key: the file
	     picker used by Documents references camera APIs, and Apple requires a
	     purpose string for any API the binary can reach, not merely the ones it
	     calls. The rejection arrives by email after "upload succeeded", so the
	     build simply never appears in TestFlight and nothing on screen says why.

	     Written as a real reason rather than filler, because iOS shows this
	     sentence verbatim if the picker is ever used to take a photo. -->
	<key>NSCameraUsageDescription</key>
	<string>So you can photograph a bill or a document and file it straight into SafeNest on your own computer.</string>

	<!-- The same rule, same library. It offers video capture, so the microphone
	     API is reachable and the string is required — again regardless of whether
	     this app ever asks for it. Better to declare it honestly now than to be
	     rejected a second time for the other half of the same picker. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Only if you record a video while adding a document. SafeNest never listens otherwise.</string>

	<!-- Reaching your own computer on your own Wi-Fi. iOS 14 and later refuse to
	     touch a local address until this is granted, and the refusal looks
	     exactly like the computer being switched off — which is the wrong thing
	     to go and check. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>So this phone can reach the computer running SafeNest when they are on the same Wi-Fi, without going out to the internet at all.</string>

	<!-- App Transport Security refuses plain http, which is right for the
	     internet and wrong for a home network: a computer at 192.168.1.5 has no
	     certificate and cannot get one. NSAllowsLocalNetworking permits http for
	     private addresses ONLY. NSAllowsArbitraryLoads is deliberately NOT set —
	     over the internet a sign-in must stay encrypted, and the app enforces the
	     same rule itself in Session.normaliseAddress. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<!-- Answers Apple's export-compliance question here rather than by hand on
	     every upload. Without it each build sits in TestFlight marked "Missing
	     Compliance" and reaches nobody until someone clicks through the same two
	     questions again — which turns a one-command release back into a chore.

	     false means "no encryption beyond the exemption": this app uses HTTPS to
	     reach the owner's own computer and nothing else. It implements no
	     cryptography of its own — the vault is AES-256-GCM on the server, under a
	     key that never leaves that machine and never reaches this app.

	     If that ever stops being true, this key has to change, and it is a legal
	     declaration rather than a convenience. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>SafeNest</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>safenest</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
